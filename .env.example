# Copy to .env and load via your shell or MCP client config
# This file is NOT auto-loaded — pass vars via -e flags or export them

ATLASSIAN_URL=https://yoursite.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_TOKEN=your-api-token
# Optional — auto-discovered from ATLASSIAN_URL if omitted
# ATLASSIAN_CLOUD_ID=your-cloud-id

# Optional — set to "true" to require user confirmation (via MCP elicitation)
# before every write operation (create/edit/transition issues, add comments,
# create/update Confluence articles). Default: unset (writes proceed immediately).
# JCM_CONFIRM_WRITES=true
